      "subtitle": { "en": "Pick the one that matters most right now.", "ar": "اختاري الأهم بالنسبة لكِ الآن." },
      "summaryLabel": { "en": "Goal", "ar": "الهدف" },
      "options": [
        {
          "id": "lose_weight",
          "label": { "en": "Lose weight", "ar": "خسارة الوزن" }
        },
        {
